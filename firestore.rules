rules_version = '2';
// Lynx Library: anyone may read which topics are hidden; only Lausanne Microsoft accounts may change it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/visibility {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'microsoft.com'
        && request.auth.token.email.lower().matches('.*@lausanneschool[.]com$')
        && request.resource.data.keys().hasOnly(['hidden', 'updatedBy', 'updatedAt'])
        && request.resource.data.hidden is list
        && request.resource.data.hidden.size() <= 100;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
